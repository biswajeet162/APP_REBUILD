# Canonical Cursor skill: .cursor/skills/project-create/SKILL.md
# Prefer the SKILL.md.

# Skill: PROJECT_CREATE (Stage 2)
# Copy kotlin_app_template OR unity_app_template into {project-name}/ at repo root.
# NEVER edit project-template/ for a specific app.

SKILL_NAME=project-create
STAGE=2

UNITY_FLOW=
1. Ask user: game folder name (e.g. 2d-racer)
2. Copy project-template/unity_app_template -> {game-name}/
3. All Stage 3 /build work happens in {game-name}/

KOTLIN_FLOW=
1. Ask or infer app name
2. Copy project-template/kotlin_app_template -> {app-name}/

COPY_SCRIPT=
powershell -File .cursor/skills/project-create/scripts/copy-template.ps1 -Technology unity -ProjectName 2d-racer

NEXT=project-build (/build)
