# Canonical Cursor skill: .cursor/skills/project-create/SKILL.md
# This file is the original note. Prefer the SKILL.md.

# Skill: PROJECT_CREATE (Stage 2)
# Purpose: Copy kotlin_app_template OR unity_app_template into a named folder at repo root.

SKILL_NAME=project-create
STAGE=2

INPUTS=analysis/* + user project name (optional)

TEMPLATE_RULE=
- game -> copy project-template/unity_app_template
- everything else -> copy project-template/kotlin_app_template
- ONLY these two templates. No Flutter. No React Native.

DESTINATION={project-name}/ at workspace root (e.g. calculator/, 2d-game/)
NOT new-project/ unless user explicitly asks.

COPY_SCRIPT=
powershell -File .cursor/skills/project-create/scripts/copy-template.ps1 -Technology kotlin -ProjectName expense-tracker
powershell -File .cursor/skills/project-create/scripts/copy-template.ps1 -Technology unity -ProjectName 2d-game

OUTPUT={project-name}/, PROJECT_STATUS.md, analysis/project-create-status.json

NEXT=project-build
